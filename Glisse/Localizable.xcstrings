    "Vignette à côté du curseur (déplacement au lâcher)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thumbnail next to the pointer (moves on release)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vignette à côté du curseur (déplacement au lâcher)"
          }
        }
      }
    },
    "« En direct » : la fenêtre suit tes doigts. Les autres modes la déplacent quand tu lèves les doigts.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Live”: the window follows your fingers. The other modes move it when you lift your fingers."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« En direct » : la fenêtre suit tes doigts. Les autres modes la déplacent quand tu lèves les doigts."
          }
        }
      }
    },
    "À autoriser dans Réglages Système → Général → Ouverture.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow it in System Settings → General → Login Items."
          }
        },
