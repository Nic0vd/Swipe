    "Swipe %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe %@"
          }
        }
      }
    },
    "Swipe vérifie une fois par jour s'il existe une nouvelle version.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe checks once a day for a new version."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe vérifie une fois par jour s'il existe une nouvelle version."
          }
        }
      }
    },
    "Tant que tes doigts sont posés, tu peux changer d'avis : la fenêtre suit.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "As long as your fingers are down, you can change your mind: the window follows."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que tes doigts sont posés, tu peux changer d'avis : la fenêtre suit."
          }
        }
      }
    },
    "Tous les gestes se font avec **deux doigts sur le trackpad**, le curseur posé sur la **barre de titre** d'une fenêtre. Partout ailleurs, le défilement marche normalement.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every gesture uses **two fingers on the trackpad**, with the pointer on a window's **title bar**. Everywhere else, scrolling works as usual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les gestes se font avec **deux doigts sur le trackpad**, le curseur posé sur la **barre de titre** d'une fenêtre. Partout ailleurs, le défilement marche normalement."
          }
        }
      }
    },
    "Très sensible": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Very sensitive"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Très sensible"
          }
        }
      }
    },
    "Vers le bas, franchement : un bouton jaune apparaît, et la fenêtre part dans le Dock quand tu lèves les doigts.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe down decisively: a yellow button appears, and the window goes to the Dock when you lift your fingers."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vers le bas, franchement : un bouton jaune apparaît, et la fenêtre part dans le Dock quand tu lèves les doigts."
          }
        }
      }
    },
    "Vers le haut : la fenêtre remplit tout l'écran, en laissant visibles la barre des menus et le Dock.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe up: the window fills the whole screen, leaving the menu bar and Dock visible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vers le haut : la fenêtre remplit tout l'écran, en laissant visibles la barre des menus et le Dock."
          }
        }
      }
    },
    "Version %@": {
      "localizations": {
        "en": {
